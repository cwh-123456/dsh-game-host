{
  "name": "@local/dsh-game-complexweeper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Complexweeper (复扫雷): a GPL-3.0 port of the Zig complex-number minesweeper rules engine, rendered on canvas for the DSH game deck's `game.stage` slot.",
  "license": "GPL-3.0-only",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
