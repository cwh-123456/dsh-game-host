{
  "name": "@local/dsh-game-tetris",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Tetris (俄罗斯方块) for the DSH game deck: 10x20 canvas board, 7-bag, hold, ghost, wall kicks, timestamp-driven gravity and autosave.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
