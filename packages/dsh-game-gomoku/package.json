{
  "name": "@local/dsh-game-gomoku",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gomoku (five in a row / 五子棋) for the DSH game deck: 15x15 canvas board, three AI levels, undo, and autosave.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
