{
  "name": "@local/dsh-game-quoridor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quoridor (wall chess / 步步为营) for the DSH game deck: 9x9 canvas board, local AI, walls, undo and autosave.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "engine.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
